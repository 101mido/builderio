# Frontend Environment Variables
# Builder.io API Key
VITE_PUBLIC_BUILDER_KEY=your_builder_key_here

# Backend Environment Variables
# Custom ping message for the /api/ping endpoint
PING_MESSAGE=ping

# FastAPI Server Configuration
# Host to bind the API server to (0.0.0.0 for all interfaces)
API_HOST=0.0.0.0

# Port for the FastAPI server
API_PORT=8000

# Enable auto-reload in development (true/false)
API_RELOAD=true

# API URL for Vite proxy (used during development)
API_URL=http://localhost:8000

# Application Settings
# Default directories for audio files and transcriptions
# These can be overridden per-tenant in the configuration
DEFAULT_SOURCE_DIR=/cc1_recordings
DEFAULT_DEST_DIR=/cc1_transcriptions
